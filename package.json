{
  "name": "pm2-manage",
  "version": "1.0.0",
  "description": "Browser dashboard for pm2 process management",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 delete pm2-manage-backend 2>/dev/null; true",
    "pm2:restart": "pm2 restart pm2-manage-backend",
    "pm2:logs": "pm2 logs pm2-manage-backend"
  }
}
